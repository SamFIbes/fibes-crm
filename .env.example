APP_NAME=FIBES
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Beirut
APP_URL=http://localhost:8088

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Inside Docker Compose these hostnames are forced to postgres and redis.
# On the host, point them at 127.0.0.1 and the published ports below.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fibes
DB_USERNAME=fibes
# Required. Never commit a real password. Staging and production refuse
# the exact values change-me, secret, and password.
DB_PASSWORD=

FORWARD_DB_PORT=54329

# Database sessions so a person can see and revoke browsers. Redis still
# holds the cache and the queue.
SESSION_DRIVER=database
# Idle timeout, in minutes. The absolute limit is separate.
SESSION_LIFETIME=60
SESSION_ABSOLUTE_MINUTES=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Pinned so the Laravel 13 prefix change does not rename the session cookie.
SESSION_COOKIE=fibes_session
# Set to true when APP_URL is https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Backup encryption key. Required before a backup can be written. Use a long random value.
FIBES_BACKUP_KEY=
# Where encrypted backup files are written. Defaults to storage/app/backups.
FIBES_BACKUP_DIRECTORY=
# Scratch database for the monthly restore test. Must not be the live database.
FIBES_BACKUP_SCRATCH=
# Optional folder on another disk. New backups are copied here.
FIBES_BACKUP_DESTINATION=
# Each outbound webhook gets its own secret in the app. It is stored encrypted and shown once.
# Do not put that secret here or in the audit log.
# Reverb is not installed. laravel/reverb 1.x needs guzzlehttp/psr7 ^2.6,
# and Laravel 13's Guzzle 8 needs guzzlehttp/psr7 ^3.2. Leave this on log.
# The sales floor polls every 2 seconds. The bell polls every 30 seconds.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FIBES_CLAMSCAN=
# File scan driver: null (built-in EICAR check) or clamav.
FIBES_FILE_SCAN_DRIVER=null
FIBES_CLAMAV_HOST=127.0.0.1
FIBES_CLAMAV_PORT=3310
# Sentry-compatible error tracker. Leave empty to keep errors in the log only.
SENTRY_DSN=
# Shared secret for the Grandstream screen-pop. Leave empty until the PBX is connected.
# The phone system signs each request with HMAC-SHA256. See docs/TELEPHONY.md.
FIBES_TELEPHONY_SECRET=
# HMAC secret for the public website lead form. See docs/LEADS.md.
FIBES_WEB_FORM_SECRET=
# Meta Lead Ads webhook. Both stay empty until the Facebook app is connected.
FIBES_META_VERIFY_TOKEN=
FIBES_META_APP_SECRET=
# Optional Cloudflare Turnstile secret for the web form. Empty skips the check.
FIBES_TURNSTILE_SECRET=
# Map tiles. The default is OpenStreetMap. Point this at your own tiles if you host them.
FIBES_MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# FiberDesk file import stays off until a file format is agreed. There is no live sync.
FIBES_FIBERDESK=false
# Quote and contract printing. html keeps the branded page. chromium needs a Chrome path.
FIBES_PDF_DRIVER=html
FIBES_CHROMIUM_BIN=
# These three are no longer what the screens read. An admin edits VAT, the deposit switch,
# and the install target under Settings → Figures still to confirm. See docs/to-confirm.md.
FIBES_VAT_PERCENT=11
# Signature codes. log keeps the latest code in cache and does not text a phone.
FIBES_SMS_DRIVER=log
# Kept so an old environment file still parses. Settings is the source the app uses.
FIBES_ORDER_DEPOSIT=false
FIBES_INSTALL_BUSINESS_DAYS=5
# Whish checkout stays off until the flag, key, URL, webhook secret, and the desk switch are on.
# A reference is still typed by hand while it is off. Paths are assumed. See docs/INTEGRATIONS.md.
FIBES_WHISH=false
FIBES_WHISH_URL=
FIBES_WHISH_API_KEY=
FIBES_WHISH_WEBHOOK_SECRET=
FIBES_WHISH_PATH_HEALTH=/api/v1/health
FIBES_WHISH_PATH_CHECKOUT=/api/v1/checkouts
# Krypton stays off until the flag, key, URL, and the desk switch are on.
# A likely base URL is https://rad.smartnetworkslb.net — leave it empty until the vendor guide is in hand.
# CSV import stays under Settings → Figures still to confirm (krypton_import).
# FIBES_RADIUS_ALSO_TASK=true also opens a NOC task after a live suspend or reactivate succeeds.
FIBES_RADIUS=false
FIBES_RADIUS_URL=
FIBES_RADIUS_API_KEY=
FIBES_RADIUS_ALSO_TASK=false
FIBES_RADIUS_PATH_HEALTH=/api/v1/health
FIBES_RADIUS_PATH_USER=/api/v1/users/{username}
FIBES_RADIUS_PATH_SUSPEND=/api/v1/users/{username}/suspend
FIBES_RADIUS_PATH_REACTIVATE=/api/v1/users/{username}/reactivate
FIBES_RADIUS_PATH_SESSION=/api/v1/users/{username}/session
# Click-to-dial needs the URL, API user, and password, plus the Grandstream desk switch.
# Screen-pop still uses FIBES_TELEPHONY_SECRET only. See docs/TELEPHONY.md.
FIBES_TELEPHONY_URL=
FIBES_TELEPHONY_USER=
FIBES_TELEPHONY_PASSWORD=
FIBES_TELEPHONY_API_PATH=/api
FIBES_TELEPHONY_DIAL_ACTION=dialOutbound
# Hub ERP (ERPNext) at The Hub Holding. Live company is Smart Network (LBP, Lebanon).
# Leave the key, secret, webhook secret, and enabled flag empty until the user has API Access.
FIBES_ERPNEXT_URL=https://erp.thehubholding.com
FIBES_ERPNEXT_API_KEY=
FIBES_ERPNEXT_API_SECRET=
FIBES_ERPNEXT_ENABLED=false
FIBES_ERPNEXT_WEBHOOK_SECRET=
FIBES_ERPNEXT_COMPANY="Smart Network"
# WhatsApp Cloud API stays off until the flag, token, phone number id, and the desk switch are on.
# Templates send only when the customer has agreed. Otherwise the link stays wa.me.
# Verify token and app secret fall back to FIBES_META_VERIFY_TOKEN and FIBES_META_APP_SECRET when empty.
FIBES_WHATSAPP=false
FIBES_WHATSAPP_TOKEN=
FIBES_WHATSAPP_PHONE_ID=
FIBES_WHATSAPP_GRAPH_VERSION=v21.0
FIBES_WHATSAPP_VERIFY_TOKEN=
FIBES_WHATSAPP_APP_SECRET=
FIBES_WHATSAPP_TEMPLATE_RENEWAL=fibes_renewal_reminder
FIBES_WHATSAPP_TEMPLATE_TICKET=fibes_ticket_update
FIBES_WHATSAPP_TEMPLATE_PAYMENT=fibes_payment_reminder
# Plan prices live in the database, not in the environment. There is no catalog API key.
# Approval deadlines live on each rule in the inbox. There is no approval API key.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# Pinned so the Laravel 13 prefix change does not orphan existing cache keys.
CACHE_PREFIX=fibes
# Pinned to the Laravel 11 fallback (fibes_database_) for the same reason.
REDIS_PREFIX=fibes_database_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=63799

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fibes.example"
MAIL_FROM_NAME="${APP_NAME}"

# First administrator. No password is stored in the repository.
# ADMIN_PASSWORD must be at least 12 characters and include upper case,
# lower case, and a number. ADMIN_LOCALE is en or ar.
ADMIN_NAME="FIBES Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_LOCALE=en

# Roles that must turn on an authenticator after the grace period.
FIBES_2FA_REQUIRED_ROLES=super_admin,management,finance,noc_engineer,cc_supervisor,ops_manager
FIBES_2FA_GRACE_DAYS=7

# Host port for the nginx container. Vite is only used when you opt into HMR.
APP_PORT=8088
VITE_PORT=5174
INERTIA_SSR_ENABLED=false
VITE_APP_NAME="${APP_NAME}"
